# deshiQR — Netlify SPA fallbacks.
#
# Client-side routes are served by the same index.html; hashed assets and public
# files are served as files first (Netlify checks the filesystem before redirects).
#
# The build output directory is apps/web/dist (from netlify.toml at the repo root).

/new            /index.html  200
/login          /index.html  200
/dashboard      /index.html  200
/dashboard/*    /index.html  200
/p/*            /index.html  200
/@*             /index.html  200
/i/*            /index.html  200

# Fallback for everything else (self-contained #p= links are client-side only,
# and any unknown path renders the app's own 404 page).
/*              /index.html  200
