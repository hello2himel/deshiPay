{
  "name": "deshiqr-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "deshiQR \u2014 load a Bangla QR payload, edit any tag, validate, and get the updated payload back. One package per platform: JS/TS (npm), Python (PyPI), browser bundle on GitHub Pages.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm build:libs",
    "build:libs": "pnpm --filter deshiqr build",
    "test": "pnpm build:libs && pnpm -r --if-present test",
    "check:globals": "node scripts/check-globals.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "dev:site": "node site/scripts/dev-server.js",
    "build:site": "pnpm build:libs && node site/scripts/refresh-engine.js",
    "test:site": "node site/tests/qr.test.js",
    "check:site": "node site/scripts/refresh-engine.js --check"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/hello2himel/deshiQR.git"
  },
  "homepage": "https://github.com/hello2himel/deshiQR#readme",
  "bugs": {
    "url": "https://github.com/hello2himel/deshiQR/issues"
  },
  "license": "MIT"
}
